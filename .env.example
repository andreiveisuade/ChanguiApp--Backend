# El equipo usa un único Supabase (compartido entre prod y dev). El SM pasa las 3 creds
# de abajo por canal privado a cada dev. NO correr syncs ni seeds desde local sin
# coordinar — escribe a la misma DB que sirve a Render. Ver docs/db-setup.md.

# URL del proyecto Supabase (Settings → API → Project URL)
SUPABASE_URL=

# Clave pública (anon). Usada para validar tokens JWT del cliente móvil.
SUPABASE_ANON_KEY=

# Clave de servicio (service_role). SOLO backend y scripts admin. NUNCA exponer al cliente móvil.
# Bypassa Row Level Security. Rotar si se compromete.
SUPABASE_SERVICE_ROLE_KEY=

# Token secreto para proteger endpoints admin (ej: /api/admin/sync-precios-claros).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guardar en Render Environment Variables y en el gestor de secrets del equipo.
ADMIN_TOKEN=

# Access token de Mercado Pago (modo sandbox para desarrollo)
MP_ACCESS_TOKEN=

# Clave secreta de la integración MP (panel → Tus integraciones → Webhooks).
# Se usa para verificar la firma (header x-signature) de las notificaciones.
# Sin esta var: en producción el webhook rechaza todo; en dev/test bypassa.
MP_WEBHOOK_SECRET=

# Seguro anti-cobro real: si != 'false', el checkout solo corre con un token de
# usuario de prueba de MP (tag 'test_user') y usa el sandbox_init_point.
# Poner 'false' SOLO para habilitar cobros reales en produccion.
MP_REQUIRE_TEST_USER=true

# URL publica del backend (back_urls y webhook de MP). En prod: la URL de Render.
PUBLIC_BASE_URL=

# Orígenes permitidos por CORS, separados por coma. Default en dev: el de Expo
# (http://localhost:8081). En prod: la(s) URL(s) del frontend.
ALLOWED_ORIGINS=http://localhost:8081

# Deep link de la app al que se reenvia tras el pago (cierra el browser in-app).
APP_RETURN_DEEP_LINK=changuiapp://checkout/return

# URL base de la API de Precios Claros (SEPA)
PRECIOS_CLAROS_URL=

# ID del store de MVP en Precios Claros (ej: 12-1-158 para Coto Charcas)
MVP_STORE_PRECIOS_CLAROS_ID=

# Delay configurable entre requests a Precios Claros durante el sync.
# Default 2000ms — necesario para aliviar presión sobre Render free tier
# (con 300ms el server respondía 503 a /health durante el sync).
SYNC_DELAY_MS=2000

# Reintentos por request a Precios Claros ante fallos transitorios (403/429/5xx).
# Default 3 (1 intento + 3 reintentos) con backoff exponencial desde 1000ms.
SYNC_MAX_RETRIES=3
SYNC_RETRY_BASE_MS=1000

# Puerto del servidor Express (default 3000 en desarrollo)
PORT=3000
